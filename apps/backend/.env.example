# Copiar como .env para desarrollo local. En Vercel no hay .env: las variables
# se cargan en Settings > Environment Variables del proyecto.

# Puerto donde se expone la API. Solo en local; en Vercel no hace falta.
PORT=3000

# Cadena de conexion a MongoDB. Obligatoria, tambien en Vercel.
# Local:  mongodb://127.0.0.1:27017/peliculas_db
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/peliculas_db
# Si la contrasena tiene caracteres como @ : / ? #, van codificados (@ = %40).
MONGO_URI=mongodb://127.0.0.1:27017/peliculas_db
